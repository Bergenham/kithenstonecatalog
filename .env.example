# Copy to .env in the repository root and replace these placeholders.
DEBUG=False
ALLOWED_HOSTS=makerstone.ru
CSRF_TRUSTED_ORIGINS=https://makerstone.ru
SEO_SITE_URL=https://makerstone.ru
SECRET_KEY='replace-with-a-long-random-secret-key'
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD='replace-with-your-database-password'
DB_HOST=localhost
DB_PORT=5432

# Production HTTPS defaults follow DEBUG=False. For local runserver use DEBUG=True.
# Enable only after Nginx replaces X-Forwarded-Proto and Gunicorn binds to loopback.
TRUST_PROXY_HEADERS=False
# Enable HSTS only after checking HTTPS. No includeSubDomains/preload by default.
SECURE_HSTS_SECONDS=0
# Keep media outside the checkout when deploying/replacing code:
# MEDIA_ROOT=/srv/kithenstonecatalog/shared/media
# STATIC_ROOT=/srv/kithenstonecatalog/app/mysite/staticfiles

# Optional, for classify_stone_params only:
# OPENAI_API_KEY='replace-with-your-api-key'
# OPENAI_VISION_MODEL=gpt-4.1-mini
